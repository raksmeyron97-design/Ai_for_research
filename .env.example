# ---------------------------------------------------------------------------
# Supabase (auth, database, storage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Used only for trusted
# server-side jobs (e.g. admin analytics aggregation), never in a
# request-scoped client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin analytics (Phase 10) — comma-separated allowlist of user emails
# permitted to view /admin. No roles table exists; this is a deliberately
# minimal env-based check rather than new schema/RLS surface for what is,
# for now, a single gate on one dashboard.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AI provider secrets — server-side only, never exposed to the browser and
# never returned in an API response.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Model routing (Section 7) — model IDs are configuration, never hard-coded.
# The IDs below were verified as served, and priced, on 2026-09-01; see
# docs/PHASE_16A_PREBENCHMARK_HARDENING.md for the sources. Re-verify before
# deploying: lineups and prices change, and src/lib/ai/pricing.ts will report
# cost as "unverified" for anything it has no rate for.
#
# Note on gpt-5.6: it is an alias that OpenAI documents as routing to
# gpt-5.6-sol ($4.00 / $20.00 per 1M) — the expensive end of a family whose
# cheapest member, gpt-5.6-luna, is $0.20 / $1.20. Pin an explicit variant
# here if you want that choice to be yours rather than the alias's.
# ---------------------------------------------------------------------------
# One model per (tier x provider). The first column is the tier's primary
# provider; the second is what a failed call falls back to *at the same tier*
# — Phase 16A finding F9, where a failed cheap task used to land on the
# reasoning model. Set a cell to empty (VAR=) to declare "this provider has
# nothing suitable at this tier", which disables fallback there rather than
# substituting a differently-priced model.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
OPENAI_FAST_MODEL=gpt-5.6-luna

GEMINI_STANDARD_MODEL=gemini-3.6-flash
OPENAI_STANDARD_MODEL=gpt-5.4-mini

GEMINI_ADVANCED_MODEL=gemini-3.1-pro-preview
OPENAI_REASONING_MODEL=gpt-5.6

GEMINI_REVIEWER_MODEL=gemini-3.1-pro-preview
OPENAI_REVIEWER_MODEL=gpt-5.6

# Embeddings (Phase 3 RAG) — must match the vector(N) column width in
# supabase/migrations/*_phase3_document_chunks.sql if changed.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Provider kill switches. These are the only two AI feature flags that do
# anything; Phase 16A deleted the rest (findings F4/F5) rather than leave
# configuration that silently changes nothing during an incident.
AI_ENABLE_OPENAI=true
AI_ENABLE_GEMINI=true

AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_TOKENS=32000

# Streaming idle-gap timeout (Phase 16A): abort when NO chunk arrives for this
# long. Deliberately not a total-duration budget — a long answer that keeps
# producing tokens must never be killed. The default is generous because a
# reasoning model can be silent for a while before its first token.
AI_STREAM_IDLE_TIMEOUT_MS=60000


# ---------------------------------------------------------------------------
# Phase 16 AI benchmark (tests/ai-benchmark/). None of these affect the app;
# they configure `npm run ai:benchmark*` only. Defaults are conservative so a
# bare run cannot spend money by surprise.
# ---------------------------------------------------------------------------
# AI_BENCH_PROVIDERS=gemini,openai
# AI_BENCH_SUITE=smoke              # smoke | full
# AI_BENCH_REPETITIONS=3
# AI_BENCH_CONCURRENCY=2
# AI_BENCH_MAX_REQUESTS=600         # hard stop on total provider calls
# AI_BENCH_MAX_SCENARIOS=200
# AI_BENCH_MAX_COST_USD=10          # hard stop on estimated spend
# AI_BENCH_TIMEOUT_MS=90000
# AI_BENCH_RETRIES=1
# AI_BENCH_JUDGE=false              # blind LLM-as-judge pass
# AI_BENCH_DRY_RUN=false            # deterministic stub, no network, MOCKED
# AI_BENCH_SCENARIOS=rag-c1-prevalence-single,...
# AI_BENCH_CATEGORIES=rag_grounding,hallucination
# AI_BENCH_GEMINI_MODELS=...        # pin exact model ids instead of the app's tiers
# AI_BENCH_OPENAI_MODELS=...
# AI_BENCH_RATE_FILE=reports/ai-benchmark/pricing.json   # without this, no USD figure is reported
# AI_BENCH_OUT_DIR=reports/ai-benchmark
