# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# ide
.claude/


# benchmark raw dumps — every run writes one full-output record per
# execution (megabytes). latest.json/latest.md are the committed artifacts;
# raw dumps are regenerated by re-running the suite.
reports/ai-benchmark/**/raw/
reports/ai-benchmark/pricing.json

# Dry-run output (Phase 21 §9). Regenerated by `npm run ai:benchmark:dry` on
# demand and MOCKED in its entirety, so committing it would put a stub report
# in the tree beside the real provider record — which is the confusion the
# directory split exists to prevent. The split itself is what is committed:
# the live artifacts stay at reports/ai-benchmark/latest.*, and a dry run can
# only ever write below dry/.
reports/ai-benchmark/dry/
tests/browser/.auth/

# Playwright run artifacts. Traces are megabytes and are regenerated by
# re-running the suite; the specs and the config are the committed record.
test-results/
playwright-report/
