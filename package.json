{
  "name": "ai-thesis-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "ai:models": "vitest run --config vitest.benchmark.config.ts tests/ai-benchmark/models.bench.ts",
    "ai:benchmark": "vitest run --config vitest.benchmark.config.ts tests/ai-benchmark/cli.bench.ts",
    "ai:benchmark:smoke": "AI_BENCH_SUITE=smoke npm run ai:benchmark",
    "ai:benchmark:full": "AI_BENCH_SUITE=full npm run ai:benchmark",
    "ai:benchmark:gemini": "AI_BENCH_PROVIDERS=gemini AI_BENCH_SUITE=full npm run ai:benchmark",
    "ai:benchmark:openai": "AI_BENCH_PROVIDERS=openai AI_BENCH_SUITE=full npm run ai:benchmark",
    "ai:benchmark:compare": "AI_BENCH_PROVIDERS=gemini,openai AI_BENCH_SUITE=full AI_BENCH_JUDGE=true npm run ai:benchmark",
    "ai:benchmark:dry": "AI_BENCH_DRY_RUN=true AI_BENCH_SUITE=full npm run ai:benchmark",
    "ai:benchmark:verify-isolation": "bash scripts/verify-benchmark-isolation.sh",
    "db:reset": "supabase db reset --local",
    "db:verify:isolation:17": "bash scripts/db-isolation.sh supabase/tests/phase17_project_isolation.sql",
    "db:verify:isolation": "bash scripts/db-isolation.sh supabase/tests/phase17_project_isolation.sql",
    "db:verify:isolation:17b": "bash scripts/db-isolation.sh supabase/tests/phase17b_project_isolation.sql",
    "db:verify:isolation:18": "bash scripts/db-isolation.sh supabase/tests/phase18_project_isolation.sql",
    "db:verify:isolation:19": "bash scripts/db-isolation.sh supabase/tests/phase19_project_isolation.sql",
    "db:verify:isolation:20": "bash scripts/db-isolation.sh supabase/tests/phase20_project_isolation.sql",
    "db:verify:isolation:21": "bash scripts/db-isolation.sh supabase/tests/phase21_project_isolation.sql",
    "db:verify:isolation:all": "bash scripts/db-isolation-all.sh"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.47.10",
    "csv-parse": "^7.0.2",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.2",
    "next": "15.5.24",
    "openai": "^7.8.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.24",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.28"
  }
}
